<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.random-quotes-desktop" path="/org/gnome/shell/extensions/random-quotes-desktop/">
    <key type="as" name="quotes">
      <default>["Stay curious.", "Simplicity is the ultimate sophistication.", "It always seems impossible until it's done.", "The best time to plant a tree was 20 years ago. The second best time is now.", "Be yourself; everyone else is already taken.", "In the middle of difficulty lies opportunity."]</default>
    </key>
    <key type="i" name="interval">
      <default>120</default>
    </key>
    <key type="s" name="mode">
      <default>"random"</default>
      <summary>random or sequential</summary>
    </key>
    <key type="s" name="position">
      <default>"bottom-right"</default>
    </key>
    <key type="i" name="font-size">
      <default>35</default>
    </key>
    <key type="s" name="text-color">
      <default>"#ffffff"</default>
    </key>
    <key type="i" name="dark-font-size">
      <default>35</default>
    </key>
    <key type="s" name="dark-text-color">
      <default>"#dddddd"</default>
    </key>
    <key type="d" name="opacity">
      <default>0.95</default>
    </key>
    <key type="d" name="shadow">
      <default>4.0</default>
    </key>
    <key type="i" name="max-width">
      <default>800</default>
      <summary>Maximum width of the quote label in pixels</summary>
    </key>
  </schema>
</schemalist>

